<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %> | KaraburunGO</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/main.css">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: rgb(37, 37, 37);
        }

        /* Sidebar Sabitleme */
        .sidebar {
            background-color: #212529;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            border-right: 1px solid rgba(255,255,255,0.05);
        }

        /* Navigasyon Linkleri */
        .nav-link {
            border-radius: 8px;
            margin-bottom: 4px;
            transition: all 0.2s ease;
        }

        /* Aktif Durum: İkon ve Metni Beyaz Yap */
        .nav-link.active {
            background-color: var(--blue-color) !important; 
            color: white !important;
        }
        
        .nav-link.active i, 
        .nav-link.active span {
            color: white !important;
        }

        .nav-link:hover:not(.active) {
            background-color: rgba(255, 255, 255, 0.1);
            color: white !important;
        }
        .sidebar .nav-link i {
            opacity: 0.7; /* Burayı 0.5 yaparsan daha da söner */
            transition: opacity 0.3s ease; /* Yumuşak geçiş için */
        }
        .sidebar .nav-link:hover i,
        .sidebar .nav-link.active i {
            opacity: 1 !important;
        }

        /* Main Content Kaydırma (Sidebar genişliği kadar offset) */
        main {
            background-color: #333b42;
            min-height: 100vh;
        }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-thumb { background-color: rgba(255, 255, 255, 0.1); border-radius: 4px; }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <%- include('./navbar.ejs') %>

            <main class="col-12 col-md-9 col-lg-10 p-4 offset-md-3 offset-lg-2 d-flex flex-column">
                <div class="flex-grow-1">
                    <%- body %>
                </div>

                <footer class="text-white text-md text-center border-top">
                    <p>&copy; <%= new Date().getFullYear() %> KaraburunGO. Tüm hakları saklıdır.</p>
                </footer>
            </main>
        </div>
    </div>

    <script src="/js/slideover-manager.js"></script>
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>