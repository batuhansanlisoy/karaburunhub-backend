<div class="table-widget-container">
  <div class="table-widget-body">
    <table class="align-middle mb-0 custom-table">
      <thead class="table-header">
        <tr id="dynamicTableHead"></tr>
      </thead>
      <tbody id="dynamicTableBody"></tbody>
    </table>
  </div>
</div>

<script>
function capitalizeFirstLetter(str) {
    if (!str || str === '-') return str;
    return str.charAt(0).toUpperCase() + str.slice(1);
}

/**
 * KaraburunGO Dinamik Tablo Render Fonksiyonu
 * @param {Array} columns - Sütun tanımları: { label, key, type, width, align, limit }
 * @param {Array} data - Tablo verisi
 * @param {String} deleteUrl - Silme işlemi için API endpoint'i
 */
function renderTable(columns, data, deleteUrl) {
    const tableHead = document.getElementById('dynamicTableHead');
    const tableBody = document.getElementById('dynamicTableBody');

    function capitalizeFirstLetter(str) {
        if (!str || str === '-') return str;
        return str.charAt(0).toUpperCase() + str.slice(1);
    }

    // --- 1. TABLE HEAD RENDER ---
    tableHead.innerHTML = '';
    columns.forEach((col, index) => {
        const th = document.createElement('th');
        th.textContent = col.label;

        // Genişlik ve Hizalama
        if (col.width) th.style.width = col.width;
        if (col.align) th.style.textAlign = col.align;

        // Resizer (Sütun Genişletme) Zımbırtısı
        const resizer = document.createElement('div');
        resizer.classList.add('resizer');
        th.appendChild(resizer);

        resizer.addEventListener('mousedown', function (e) {
            const startX = e.pageX;
            const startWidth = th.offsetWidth;

            const onMouseMove = (e) => {
                const newWidth = startWidth + (e.pageX - startX);
                th.style.width = `${newWidth}px`;
            };

            const onMouseUp = () => {
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            };

            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
        });

        tableHead.appendChild(th);
    });

    // --- OTOMATİK SPACER (BAŞLIK) ---
    // Tablonun sağda kesik durmaması için boşluğu yutan hayalet başlık
    const spacerTh = document.createElement('th');
    spacerTh.style.width = 'auto';
    tableHead.appendChild(spacerTh);

    // --- 2. TABLE BODY RENDER ---
    tableBody.innerHTML = '';
    data.forEach(row => {
        const tr = document.createElement('tr');

        columns.forEach(col => {
            const td = document.createElement('td');
            let value = row[col.key] ?? '-';

            // Hücre bazlı hizalama
            if (col.align) td.style.textAlign = col.align;

            // Veri Tiplerine Göre Formatlama
            if (col.type === 'phone' && value !== '-') {
                const digits = value.replace(/\D/g, '');
                td.textContent = digits.replace(/(\d{3})(\d{3})(\d{4})/, '($1) $2-$3');
            } 
            else if (col.type === 'date' && value !== '-') {
                const d = new Date(value);
                td.textContent = `${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`;
            } 
            else if (col.type === 'html') {
                td.innerHTML = value;
            } 
            else if (col.type === 'longtext' && value !== '-') {
                const limit = col.limit || 50;
                if (value.length > limit) {
                    td.innerHTML = `<span class="text-truncate-custom" onclick="alert(\`${value.replace(/"/g, '&quot;')}\`)">${value.substring(0, limit)}...</span>`;
                } else {
                    td.textContent = value;
                }
            } 
            else {
                td.textContent = capitalizeFirstLetter(value);
            }
            tr.appendChild(td);
        });

        // --- OTOMATİK SPACER (HÜCRE) ---
        // Verileri sola yaslamak için her satırın sonuna boş hücre
        const spacerTd = document.createElement('td');
        tr.appendChild(spacerTd);

        tableBody.appendChild(tr);
    });

    // --- 3. DELETE ACTION ---
    document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.onclick = async () => {
            const id = btn.dataset.id;
            if (id && confirm("Bu kaydı silmek istediğine emin misin?")) {
                try {
                    const res = await fetch(`${deleteUrl}/${id}`, { method: 'DELETE' });
                    if (res.ok) { 
                        location.reload(); 
                    } else { 
                        alert("Silme başarısız."); 
                    }
                } catch (err) { 
                    console.error("Silme Hatası:", err); 
                }
            }
        };
    });
}
</script>