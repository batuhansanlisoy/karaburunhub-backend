<form id="edit-form" data-notification-id="<%= notificationId %>">
    <div class="mb-3">
        <label class="form-label">Bildirim Başlığı</label>
        <input type="text" name="title" class="form-control" value="<%= title %>" required>
    </div>
    <div class="mb-3">
        <label class="form-label">Mesaj</label>
        <textarea name="message" rows="3" class="form-control"><%= message %></textarea>
    </div>
    <div class="col-6">
        <div class="form-check form-switch d-flex align-items-center">
            <input 
                class="form-check-input mt-0"
                type="checkbox"
                name="is_active"
                id="is_active"
                <%= is_active ? 'checked' : '' %>
            >
            <label class="form-check-label ms-2" for="is_active">Aktif / Pasif</label>
        </div>
    </div>
    <button type="submit" class="btn bg-blue text-white w-100 mt-3">Kaydet</button>
</form>
