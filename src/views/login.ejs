<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yönetim Paneli Giriş | KaraburunGO</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/main.css">
    
    <style>

        body {
            background-color: #f8f9fa;
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background-color: #fff;
            width: 100%;
            max-width: 450px;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.06);
            border: 1px solid #eee;
            overflow: hidden;
            animation: fadeIn 0.5s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .login-header {
            padding: 40px 30px;
            text-align: center;
            border-bottom: 1px solid #f8f9fa;
        }

        .form-control {
            border: 2px solid #f0f0f0;
            padding: 12px 15px;
            border-radius: 10px;
            transition: 0.3s;
            font-size: 15px;
        }

        .form-control:focus {
            border-color: var(--red-color);
            box-shadow: none;
            outline: none;
        }

        .login-btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 12px;
            font-weight: 700;
            background-color: var(--red-color);
            color: white;
            transition: 0.3s;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-top: 10px;
        }

        .login-btn:hover {
            opacity: 0.9;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(230, 57, 70, 0.2);
        }

        .error-alert {
            background-color: #fff5f5;
            color: #c53030;
            border: 1px solid #feb2b2;
            padding: 12px;
            border-radius: 10px;
            font-size: 14px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .text-red {
            color: var(--red-color) !important;
        }

        .form-control::placeholder {
            color: #6c757d;
            opacity: 0.5;
        }
    </style>
</head>
<body>

<div class="container d-flex justify-content-center">
    <div class="login-card">
        <div class="login-header">
            <h2 class="fw-bold m-0">Karaburun<span class="text-red">GO</span></h2>
            <p class="text-muted small mt-2">Yönetim Paneli Erişimi</p>
        </div>
        
        <div class="p-2 p-sm-5">
            <form action="/login" method="POST">
                
                <% if (typeof error !== 'undefined') { %>
                    <div class="error-alert">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <%= error %>
                    </div>
                <% } %>

                <div class="mb-3">
                    <label class="form-label fw-bold text-secondary small">E-Posta Adresi</label>
                    <div class="input-group">
                        <input type="email" name="email" class="form-control" placeholder="admin@karaburungo.com" required>
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-bold text-secondary small">Şifre</label>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>

                <button type="submit" class="login-btn shadow-sm">
                    Giriş Yap
                </button>

                <div class="text-center mt-4">
                    <p class="small text-muted mb-0">
                        &copy; <%= new Date().getFullYear() %> <strong>KaraburunGO</strong>
                    </p>
                    <p style="font-size: 10px;" class="text-uppercase text-light-emphasis mt-1">Admin Control Suite v1.0</p>
                </div>
            </form>
        </div>
    </div>
</div>

</body>
</html>