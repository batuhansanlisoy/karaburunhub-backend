<form id="upload-form" data-place-id="<%= placeId %>" enctype="multipart/form-data">
    <label class="form-label">Kapak Fotoğrafı</label>
    <div class="mb-4">
        <input type="file" name="cover" accept="image/*" class="form-control">
        
        <% if (place && place.cover && place.cover !== "") { 
            // Mobil uyumlu veriyi (JSON String) burada parse ediyoruz
            let coverData = typeof place.cover === 'string' ? JSON.parse(place.cover) : place.cover;
        %>
            <div class="mt-2 d-flex align-items-center gap-2">
                <div class="flex-grow-1 overflow-hidden">
                    <small class="text-muted d-block mb-1" style="font-size: 0.7rem;">Mevcut Kapak:</small>
                    <a href="<%= coverData.url %>" target="_blank" class="text-white text-decoration-none small d-block text-truncate">
                        <i class="bi bi-file-earmark-image me-1"></i>
                        <i><%= coverData.filename %></i>
                    </a>
                </div>
                <button type="button" 
                        class="btn btn-outline-danger rounded-circle d-flex align-items-center justify-content-center p-0 delete-image" 
                        style="width: 25px; height: 25px; min-width: 25px;" 
                        data-type="cover"
                        data-place-id="<%= placeId %>">
                    <i class="bi bi-trash3-fill" style="font-size: 0.7rem;"></i>
                </button>
            </div>
        <% } %>
    </div>

    <label class="form-label">Galeri Fotoğrafları</label>
    <div class="mb-3">
        <input type="file" name="gallery[]" accept="image/*" multiple class="form-control">
        
        <% if (place && place.gallery && place.gallery.length > 0) { %>
            <div class="mt-3 d-flex flex-column gap-2">
                <small class="text-muted d-block" style="font-size: 0.7rem;">Mevcut Galeri:</small>
                
                <% place.gallery.forEach((imgUrl, index) => { 
                    const fileName = imgUrl.split('/').pop();
                %>
                    <div class="d-flex align-items-center gap-2 p-1 border-bottom border-secondary border-opacity-25">
                        <div class="flex-grow-1 overflow-hidden">
                            <a href="<%= imgUrl %>" target="_blank" class="text-white text-decoration-none small d-block text-truncate">
                                <i class="bi bi-image me-1"></i>
                                <i><%= fileName %></i>
                            </a>
                        </div>
                        
                        <button type="button" 
                                class="btn btn-outline-danger rounded-circle d-flex align-items-center justify-content-center p-0 delete-image" 
                                style="width: 25px; height: 25px; min-width: 25px;"
                                data-type="gallery" 
                                data-index="<%= index %>"
                                data-place-id="<%= placeId %>">
                            <i class="bi bi-trash3-fill" style="font-size: 0.7rem;"></i>
                        </button>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="mt-3 small text-muted">Henüz galeri fotoğrafı yüklenmemiş.</div>
        <% } %>
    </div>

    <button type="submit" class="btn bg-blue text-white w-100 mt-3">Yükle</button>
</form>
