<form id="upload-form" data-beach-id="<%= beachId %>" enctype="multipart/form-data">
    <label class="form-label">Kapak Fotoğrafı</label>
    <div class="mb-3">
        <input type="file" name="cover" accept="image/*" class="form-control">
    </div>

    <label class="form-label">Galeri Fotoğrafları</label>
    <div class="mb-3">
        <input type="file" name="gallery[]" accept="image/*" multiple class="form-control">
    </div>
    <button type="submit" class="btn bg-blue text-white w-100 mt-3">Yükle</button>
</form>
