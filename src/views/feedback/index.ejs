<div>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <div class="p-2 bg-blue text-white rounded-5 px-4 d-flex align-items-center justify-content-center">
            <h2 class="mb-0 fs-6 text-center"><%= title %></h2>
        </div>
        <button id="openFilter" class="btn btn-dark rounded-5">
            <i class="bi bi-filter me-2"></i>Filtre
        </button>
        <input type="text" id="searchInput" class="form-control rounded-5 w-100 w-md-auto" placeholder="Ara..." style="max-width: 250px;">
    </div>

    <%- include('../ui/table.ejs', { title: "Geri Bildirim" }) %>
</div>

<script>
async function refreshTable() {
    try {
        const feedbacks = await fetch("/feedback/list");

        const data = await feedbacks.json();

        const columns = [
            { label: '', key: 'id', width: '50px' },
            { label: 'Ad', key: 'name', align: 'left', width: '200px'},
            { label: 'Soyad', key: 'last_name', align: 'left', width: '200px' },
            { label: 'E-mail', key: 'email', width: '200px' },
            { label: 'Telefon', key: 'phone', type: 'phone', width: '200px' },
            { label: 'Mesaj', key: 'message', type: 'longtext', width: '400px', limit: 40 },
            { label: 'Oluşturulma Tarihi', key: 'created_at', type: 'date', width: '200px' }
        ];

        const rows = data.map((item) => {
            return {
                id: String(item.id),
                name: item.name,
                last_name: item.last_name,
                email: item.email,
                phone: item.phone,
                message: item.content.message,
                created_at: item.created_at
            };
        });

        renderTable(columns, rows, "/feedback");
    } catch (err) { console.error(err); }
}

document.addEventListener("DOMContentLoaded", () => {
    refreshTable();
});
</script>
